{
  "manifest_version": 3,
  "name": "ChatGPT Conversation Exporter",
  "version": "1.1.1",
  "description": "Export the current ChatGPT conversation to Markdown or plain text.",
  "minimum_chrome_version": "95",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html",
    "default_title": "Conversation Exporter"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ]
}
